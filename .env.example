# Set these in your shell or hosting environment. No credentials are needed locally.
DATABASE_PATH=./data/shareyourmountain.sqlite
HOST=127.0.0.1
PORT=8787
# NODE_ENV=production serves the built React application.
# A public deployment must supply real authentication; the current profile is local-only.

# Optional build-time map provider settings (public, never put secrets here).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=OpenStreetMap contributors

# Optional server-only Instagram configuration. Never use VITE_ for these values.
# Set these in the server process environment; see docs/MOUNTAIN_PHOTOS.md.
# INSTAGRAM_ACCESS_TOKEN=replace-with-approved-server-token
# INSTAGRAM_USER_ID=replace-with-numeric-professional-user-id
# INSTAGRAM_API_VERSION=replace-with-supported-version
# INSTAGRAM_MOUNTAIN_HASHTAGS={"10":"replace-with-numeric-hashtag-id"}
